APP_ENV=development
DATA_SOURCE=mock
# CORS_ORIGINS overrides the development whitelist; leave unset for local Vite.
# CORS_ORIGINS=["https://expense.example.com"]
POSTGRES_DB=expense_m4a_demo
POSTGRES_USER=expense
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://expense:<URL-encoded-local-password>@localhost:55432/expense_m4a_demo
LLM_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1024
# Explicit live gate; offline pytest never makes DeepSeek requests.
RUN_LIVE_LLM_TESTS=0
EMBEDDING_MODEL=BAAI/bge-m3
POLICY_RETRIEVER=inmemory
EMBEDDING_PROVIDER=remote
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
# Explicit OpenAI-style dialect; other service dialects require their own adapter.
# Supply /v1 as part of the base URL if the service requires it.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=15
EMBEDDING_MAX_ATTEMPTS=3
# Set 1 for services without batch input support.
EMBEDDING_BATCH_SIZE=16
# TEST_DATABASE_URL must name an empty disposable fde_m0_test_* database.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Local invoice OCR; no cloud calls. Install Tesseract separately.
OCR_BINARY=tesseract
OCR_LANGUAGES=eng
# For Chinese, use chi_sim+eng and a local tessdata directory (see UI-P2 docs).
# OCR_TESSDATA=output/ui-p2/tessdata
