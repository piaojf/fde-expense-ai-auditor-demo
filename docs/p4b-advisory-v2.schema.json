{
  "$defs": {
    "AdvisoryFindingV2": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "GENERAL_FINANCE_CHECK",
            "VERIFIED_STAY",
            "POLICY_EFFECTIVE",
            "PRIOR_APPROVAL_VERIFIED",
            "AMOUNT_WITHIN_LIMIT",
            "BUSINESS_PURPOSE_UNRESOLVED",
            "MISSING_REQUIRED_EVIDENCE",
            "RULE_FAILURE",
            "FACT_CONFLICT"
          ],
          "title": "Code",
          "type": "string"
        },
        "classification": {
          "enum": [
            "INFO",
            "WARNING",
            "BLOCKER"
          ],
          "title": "Classification",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "NOT_APPLICABLE",
            "UNRESOLVED"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "policy_ref_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Policy Ref Ids",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "rule_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Rule Refs",
          "type": "array"
        },
        "fact_key": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Key"
        },
        "source_quote": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Quote"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        }
      },
      "required": [
        "code",
        "classification",
        "resolution",
        "policy_ref_ids",
        "fact_refs",
        "rule_refs"
      ],
      "title": "AdvisoryFindingV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p4b.advisory.2",
      "default": "p4b.advisory.2",
      "title": "Schema Version",
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNDETERMINED"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "recommendation": {
      "enum": [
        "RECOMMEND_APPROVAL",
        "RECOMMEND_REJECTION",
        "REQUEST_EVIDENCE",
        "ESCALATE",
        "UNDETERMINED"
      ],
      "title": "Recommendation",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/AdvisoryFindingV2"
      },
      "maxItems": 16,
      "title": "Issues",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Missing Evidence",
      "type": "array"
    },
    "policy_ref_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Policy Ref Ids",
      "type": "array"
    },
    "fact_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Fact Refs",
      "type": "array"
    },
    "requires_human_review": {
      "const": true,
      "title": "Requires Human Review",
      "type": "boolean"
    }
  },
  "required": [
    "risk_level",
    "recommendation",
    "issues",
    "missing_evidence",
    "policy_ref_ids",
    "fact_refs",
    "requires_human_review"
  ],
  "title": "AdvisoryOutputV2",
  "type": "object"
}
